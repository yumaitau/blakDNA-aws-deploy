{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "database",
    "hermes",
    "runtimeSecret",
    "publicOrigin",
    "serviceAccount"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/.+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "host",
        "port",
        "name",
        "user",
        "sslmode"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "sslmode": {
          "enum": [
            "require",
            "verify-ca",
            "verify-full"
          ]
        }
      }
    },
    "hermes": {
      "type": "object",
      "required": [
        "baseUrl"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https://.+$"
        }
      }
    },
    "runtimeSecret": {
      "type": "object",
      "required": [
        "name",
        "databasePasswordKey"
      ]
    },
    "publicOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
